{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-6",
  "small_model": "anthropic/claude-haiku-4-5",
  "autoupdate": true,
  "share": "manual",
  "plugin": [
    "@dietrichgebert/ponytail",
    "opencode-models-discovery@latest"
  ],
  "provider": {
    "pcg": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "PCG AI Gateway",
      "options": {
        "baseURL": "https://gateway.pcg.io",
        "modelsDiscovery": {
          "enabled": true
        }
      }
    }
  },
  "enabled_providers": [
    "anthropic",
    "github-copilot",
    "pcg"
  ],
  "permission": {
    "edit": {
      "*": "ask",
      "*.json": "allow",
      "*.md": "allow",
      "*.py": "allow",
      "*.tf": "allow",
      "*.toml": "allow",
      "*.yaml": "allow",
      "*.yml": "allow"
    },
    "bash": {
      "*": "ask",
      "git add *": "allow",
      "git commit *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "cat *": "allow",
      "uv *": "allow",
      "ls *": "allow",
      "find *": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "formatter": {
    "jq": {
      "command": [
        "jq",
        "."
      ],
      "extensions": [
        "json"
      ]
    },
    "prettier-yaml": {
      "command": [
        "prettier",
        "--parser",
        "yaml"
      ],
      "extensions": [
        "yaml",
        "yml"
      ]
    }
  },
  "instructions": [],
  "mcp": {
    "excalidraw": {
      "type": "remote",
      "url": "https://mcp.excalidraw.com",
      "enabled": true
    },
    "adk-docs": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "mcpdoc",
        "--with",
        "mcp[cli]<2",
        "mcpdoc",
        "--urls",
        "AgentDevelopmentKit:https://adk.dev/llms.txt",
        "--transport",
        "stdio"
      ],
      "enabled": true
    },
    "pydantic-docs": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "mcpdoc",
        "--with",
        "mcp[cli]<2",
        "mcpdoc",
        "--urls",
        "PydanticDocs:https://pydantic.dev/llms.txt",
        "--transport",
        "stdio"
      ],
      "enabled": true
    },
    "langfuse-docs": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "mcpdoc",
        "--with",
        "mcp[cli]<2",
        "mcpdoc",
        "--urls",
        "LangfuseDocs:https://langfuse.com/llms.txt",
        "--transport",
        "stdio"
      ],
      "enabled": true
    },
    "docker-docs": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "mcpdoc",
        "--with",
        "mcp[cli]<2",
        "mcpdoc",
        "--urls",
        "DockerDocs:https://docs.docker.com/llms.txt",
        "--transport",
        "stdio"
      ],
      "enabled": true
    },
    "chainlit-docs": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "mcpdoc",
        "--with",
        "mcp[cli]<2",
        "mcpdoc",
        "--urls",
        "ChainlitDocs:https://docs.chainlit.io/llms.txt",
        "--transport",
        "stdio"
      ],
      "enabled": true
    },
    "uv-docs": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "mcpdoc",
        "--with",
        "mcp[cli]<2",
        "mcpdoc",
        "--urls",
        "UVDocs:https://docs.astral.sh/uv/llms.txt",
        "--transport",
        "stdio"
      ],
      "enabled": true
    }
  }
}
